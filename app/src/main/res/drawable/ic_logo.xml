    <!-- Candlestick 4 (bullish - green) - far right -->
    <!-- Wick top -->
    <path
        android:strokeColor="#00C853"
        android:strokeWidth="2"
        android:pathData="M76,16 L76,28" />
    <!-- Body -->
    <path
        android:fillColor="#00C853"
        android:pathData="M73,28 L79,28 L79,44 L73,44 Z" />
    <!-- Wick bottom -->
    <path
        android:strokeColor="#00C853"
        android:strokeWidth="2"
        android:pathData="M76,44 L76,54" />

    <!-- Upward trend line -->
    <path
        android:strokeColor="#2196F3"
        android:strokeWidth="2"
        android:pathData="M19,70 L40,62 L58,58 L76,50"
        android:fillColor="#00000000" />

