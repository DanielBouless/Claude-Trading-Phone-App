    <!-- Candlestick 1 (bearish - red) - left -->
    <!-- Wick top -->
    <path
        android:strokeColor="#FF1744"
        android:strokeWidth="2"
        android:pathData="M22,20 L22,28" />
    <!-- Body -->
    <path
        android:fillColor="#FF1744"
        android:pathData="M19,28 L25,28 L25,42 L19,42 Z" />
    <!-- Wick bottom -->
    <path
        android:strokeColor="#FF1744"
        android:strokeWidth="2"
        android:pathData="M22,42 L22,50" />

    <!-- Candlestick 2 (bullish - green) - middle -->
    <!-- Wick top -->
    <path
        android:strokeColor="#00C853"
        android:strokeWidth="2"
        android:pathData="M40,18 L40,30" />
    <!-- Body -->
    <path
        android:fillColor="#00C853"
        android:pathData="M37,30 L43,30 L43,48 L37,48 Z" />
    <!-- Wick bottom -->
    <path
        android:strokeColor="#00C853"
        android:strokeWidth="2"
        android:pathData="M40,48 L40,56" />

    <!-- Candlestick 3 (bullish - green) - right center -->
